<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-android</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <CheckEolWorkload>false</CheckEolWorkload>
    <CheckEolWorkloads>false</CheckEolWorkloads>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NETSDK1202</WarningsNotAsErrors>
    <ApplicationId>com.fmodel.android</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <SupportedOSPlatformVersion>23</SupportedOSPlatformVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <PublishTrimmed>false</PublishTrimmed>
    <RunAOTCompilation>false</RunAOTCompilation>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Android" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="CUE4Parse" Version="1.1.1" ExcludeAssets="compile;runtime" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="CUE4Parse">
      <HintPath>$(NuGetPackageRoot)cue4parse/1.1.1/lib/net8.0/CUE4Parse.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
